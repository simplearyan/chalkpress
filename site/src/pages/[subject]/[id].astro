---
// Problem page — Part 1 "Work the problem" (quiz + givens + worked steps),
// Part 2 "Build the short" (player + script + code drawer), then Up Next.
// Generated from the canonical content store; design system in styles/site.css.
import { readFileSync, existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import AppBar from '../../components/AppBar.astro';
import BottomNav from '../../components/BottomNav.astro';
import Player from '../../components/Player.astro';
import { posterFor } from '../../lib/posters.js';
import { compileStoryboard } from '../../../../runtime/hic-storyboard.esm.js';

export async function getStaticPaths() {
  const all = await getCollection('subjects');
  return all.map((e) => {
    const siblings = all.filter((x) => x.data.subject === e.data.subject);
    const i = siblings.findIndex((x) => x.data.id === e.data.id);
    const next = siblings.length > 1 ? siblings[(i + 1) % siblings.length] : null;
    return { params: { subject: e.data.subject, id: e.data.id }, props: { q: e, next } };
  });
}

const { q, next } = Astro.props;
const d = q.data;
const secs = Math.round((d.duration_ms || 15000) / 1000);
const title = `${d.title} · IITM Shorts`;
const description = `${d.title} — ${d.topic.replace(/-/g, ' ')} (${d.difficulty}). Worked solution, narration script, and the animation code behind the ${secs}-second short.`;
/* hero chip — the topic · difficulty label above the title */
const chipText = `${d.topic.replace(/-/g, ' ')} · ${d.difficulty}`;
/* the app bar carries the SERIES name (the question title is right below it in
   the hero); the in-page sections drive both the segmented tabs and the
   phone bottom nav, keyed on the same data-tab values. */
const series = d.subject.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const sections = [
  { id: 'solve', label: 'Work the problem', short: 'Solve' },
  { id: 'produce', label: 'Build the short', short: 'Build' },
  { id: 'next', label: 'Up next', short: 'Up next' },
];
const tabs = sections.filter((s) => s.id !== 'next');
const correct = d.options.find((o) => o.correct);

/* solution.md / script.md live next to index.md in the content store
   (outside src/, so they're read from disk at build time). */
function readSibling(name) {
  try {
    const p = new URL(`../../../../content/subjects/${d.subject}/${d.id}/${name}`, import.meta.url);
    return existsSync(p) ? readFileSync(p, 'utf8') : '';
  } catch { return ''; }
}

/* "## 1. Title" → { n, title, html } steps for the numbered timeline */
const steps = (readSibling('solution.md').split(/^## /m).filter((s) => s.trim())).map((part, i) => {
  const nl = part.indexOf('\n');
  const head = part.slice(0, nl).trim();
  const m = head.match(/^(\d+)\.?\s*(.*)$/);
  return {
    n: m ? m[1] : String(i + 1),
    title: m ? m[2] : head,
    html: marked.parse(part.slice(nl + 1).trim()),
  };
});

/* "## 0–4s · scene: intro" → { time, html } beats for script + visual plan */
const beats = (readSibling('script.md').split(/^## /m).filter((s) => s.trim())).map((part) => {
  const nl = part.indexOf('\n');
  const head = part.slice(0, nl).trim();
  const tm = head.match(/^([\d.]+(?:[–-][\d.]+)?)s/);
  return { time: tm ? `${tm[1]}s` : head, html: marked.parse(part.slice(nl + 1).trim()) };
});

/* Code drawer: the same compiled clip the player renders. The storyboard
   lives beside index.md as storyboard.json (read at build time). */
let storyboard = null;
try {
  const sbp = new URL(`../../../../content/subjects/${d.subject}/${d.id}/storyboard.json`, import.meta.url);
  if (existsSync(sbp)) storyboard = JSON.parse(readFileSync(sbp, 'utf8'));
} catch { storyboard = null; }
const clip = storyboard ? compileStoryboard(storyboard) : null;
---
<Base title={title} description={description} ogImage={`/meta-src/${d.id}-og.png`}>
  <AppBar title={series} back={{ href: `/${d.subject}/`, label: 'Library' }} tabs={tabs} />
  <BottomNav items={sections} />

  <div class="wrap-top">
    <header class="page-head">
      <span class="chip">{chipText}</span>
      <h1>{d.title}</h1>
      <p>{d.source}</p>
    </header>

    <!-- ===================== PART 1: SOLVE ===================== -->
    <section id="part-solve" class="part part-solve">
      <div class="part-head">
        <div class="kicker-sm">PART 1</div>
        <h2>Work the problem</h2>
        <p class="sub">Set up the givens, then work through the solution one step at a time.</p>
      </div>

      {d.options.length > 0 && (
        <div class="try-card card" id="try-yourself">
          <div class="try-badge">Try it yourself</div>
          <p class="try-prompt">Pick the option that matches your answer, then check it against the worked steps below.</p>
          <div class="try-options">
            {d.options.map((o) => (
              <button type="button" class="try-option" data-correct={String(o.correct)}>
                <span class="k" aria-hidden="true">{o.id}</span>
                <span class="opt-body">{o.text}</span>
              </button>
            ))}
          </div>
          <div class="try-feedback" id="try-feedback" role="status" aria-live="polite"></div>
        </div>
      )}

      <div class="solve-grid">
        {d.given.length > 0 && (
          <aside class="given-card card">
            <div class="tag">Given</div>
            <dl class="given-list">
              {d.given.map((g) => (
                <div class="given-row"><dt>{g.label}</dt><dd>{g.value}</dd></div>
              ))}
            </dl>
            {d.goal && (
              <div class="goal-box">
                <div class="goal-label">Goal</div>
                <div class="goal-value">{d.goal}</div>
              </div>
            )}
          </aside>
        )}

        <div class="solution-flow">
          <h3 class="flow-title">Solving it</h3>
          <div class="steps" id="steps">
            {steps.map((s) => (
              <div class="step">
                <div class="step-num">{s.n}</div>
                <div>
                  <h3>{s.title}</h3>
                  <div class="prose" set:html={s.html} />
                </div>
              </div>
            ))}
          </div>

          {/* Walkthrough: the steps and the answer start hidden in favour of
              this control strip (see the script below). */}
          <div class="walk-ctl" id="walk-ctl" hidden>
            <span class="walk-dots" id="walk-dots" aria-hidden="true">
              {steps.map(() => <i />)}
            </span>
            <span class="walk-count" id="walk-count" role="status" aria-live="polite"></span>
            <button class="btn text" id="walk-all" type="button">Show all</button>
            <button class="btn filled" id="walk-next" type="button">
              <span class="walk-label">Next step</span>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
            </button>
          </div>

          {/* the answer sits after the timeline, not inside it — the steps are
              the derivation, this is the result (and the walkthrough reveals it
              between the two) */}
          <div class="answer-card" id="answer">
            <div>
              <div class="label">Answer</div>
              <div class="value">{d.answer}</div>
            </div>
            {correct && <span class="answer-badge">✓ Matches option {correct.id}</span>}
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ===================== PART 2: PRODUCE ===================== -->
  <section id="part-produce" class="zone-produce">
    <div class="wrap-produce">
      <div class="part-head part-produce">
        <div class="kicker-sm">PART 2</div>
        <h2>Build the short</h2>
        <p class="sub">Preview the {secs}-second explainer, then grab the script and the code behind it.</p>
      </div>

      <div class="produce-grid">
        <Player storyboard={storyboard} prompt={d.prompt || ''} />

        <section class="card">
          <div class="script-head">
            <div class="title-group">
              <svg class="yt" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
              <h3>Short-form script</h3>
            </div>
          </div>
          <div class="script-sheet">
            {beats.map((b) => <Fragment set:html={b.html} />)}
          </div>
          <div class="plan-title">Visual plan ({secs}s loop)</div>
          <ul class="plan-list">
            {beats.map((b) => (
              <li>
                <time>{b.time}</time>
                <Fragment set:html={b.html} />
              </li>
            ))}
          </ul>
        </section>
      </div>

      {clip && (
        <details class="card code-card">
          <summary>
            <span class="title-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              <h3>Animation code</h3>
            </span>
            <span class="summary-right">
              <span class="code-hint">HTML · CSS · JS — copy &amp; drop in</span>
              <svg class="chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </summary>
          <div class="code-tabs-head">
            <p class="code-note">Self-contained — compiled from this question's storyboard; paste the HTML, CSS and JS into any page and the player works as-is.</p>
          </div>
          {clip && [
            <div class="code-lang-block">
              <div class="code-lang-head"><span class="lang-pill">HTML</span></div>
              <div class="code-block-wrap"><pre><code>{`<!--
  Requires KaTeX for the math rendering. Load once, before this markup:
    https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css   (stylesheet)
    https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js
    https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js
-->\n${clip.html}`}</code></pre></div>
            </div>,
            <div class="code-lang-block">
              <div class="code-lang-head"><span class="lang-pill">CSS</span></div>
              <div class="code-block-wrap"><pre><code>{clip.css}</code></pre></div>
            </div>,
            <div class="code-lang-block">
              <div class="code-lang-head"><span class="lang-pill">JS</span></div>
              <div class="code-block-wrap"><pre><code>{clip.js}</code></pre></div>
            </div>,
          ]}
        </details>
      )}
    </div>
  </section>

  <!-- ===================== UP NEXT ===================== -->
  <section class="zone-upnext" id="part-next">
    <div class="wrap-upnext">
      <div class="upnext-label">UP NEXT</div>
      {next && (
        <a class="upnext-card" href={`/${next.data.subject}/${next.data.id}/`}>
          <div class="upnext-thumb">
            <div class="upnext-poster">
              <div class="u-eyebrow">{posterFor(next.data).eyebrow}</div>
              <div class="u-value" style={`color:${posterFor(next.data).color}`}>{posterFor(next.data).value}</div>
            </div>
          </div>
          <div class="upnext-meta">
            <div class="u-title">{next.data.title}</div>
            <div class="u-sub">{next.data.source}</div>
          </div>
          <span class="upnext-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </span>
        </a>
      )}
      <a class="upnext-library-link" href="/">← Back to Shorts library</a>
    </div>
  </section>
</Base>

<script>
  /* Wide display equations scroll inside their own surface. A scrollable region
     that cannot be focused is unreachable by keyboard, so after KaTeX has
     typeset (it runs on DOMContentLoaded) label only the ones that actually
     overflow. */
  (function markOverflowingMath() {
    const surfaces = [...document.querySelectorAll<HTMLElement>('.prose p')]
      .filter((el) => el.querySelector('.katex-display'));
    if (!surfaces.length) return;
    const mark = () => {
      for (const el of surfaces) {
        if (el.scrollWidth <= el.clientWidth + 1) continue;
        el.tabIndex = 0;
        el.setAttribute('role', 'region');
        el.setAttribute('aria-label', 'Equation — scrolls horizontally');
      }
    };
    // typeset happens on DOMContentLoaded and again as fonts land
    requestAnimationFrame(mark);
    window.addEventListener('load', mark);
    setTimeout(mark, 600);
  })();

  /* Try-it quiz: one attempt. Picking locks the row and always marks the
     correct option, so a wrong guess still teaches something; the outcome is
     announced through the live region on #try-feedback. */
  const tryCard = document.getElementById('try-yourself');
  const opts = [...document.querySelectorAll<HTMLButtonElement>('.try-option')];
  const fb = document.getElementById('try-feedback');
  for (const btn of opts) {
    btn.addEventListener('click', () => {
      if (!tryCard || tryCard.classList.contains('answered')) return;
      tryCard.classList.add('answered');
      const ok = btn.dataset.correct === 'true';
      for (const b of opts) {
        b.disabled = true;
        b.classList.toggle('correct', b.dataset.correct === 'true');
        b.classList.toggle('incorrect', b === btn && !ok);
      }
      if (fb) {
        fb.classList.add('shown');
        fb.classList.toggle('is-correct', ok);
        fb.classList.toggle('is-incorrect', !ok);
        fb.textContent = ok
          ? '✓ Correct — the full breakdown is one step at a time below.'
          : '✗ Not quite — the correct option is highlighted; the breakdown is below.';
      }
    });
  }

  /* Walkthrough: reveal the derivation one step at a time, then the answer.
     The steps render visible so the page still reads without JS; this script
     collapses them to step 1 (or the saved step) as soon as it runs. Progress
     is remembered per question, not globally. */
  (function walkthrough() {
    const box = document.getElementById('steps');
    const ctl = document.getElementById('walk-ctl');
    const answer = document.getElementById('answer');
    if (!box || !ctl || !answer) return;
    const steps = [...box.querySelectorAll<HTMLElement>('.step')];
    if (!steps.length) return;
    const dots = [...document.querySelectorAll<HTMLElement>('#walk-dots i')];
    const count = document.getElementById('walk-count');
    const nextBtn = document.getElementById('walk-next') as HTMLButtonElement;
    const allBtn = document.getElementById('walk-all') as HTMLButtonElement;
    const label = nextBtn.querySelector('.walk-label') as HTMLElement;
    const flow = box.parentElement as HTMLElement;
    const total = steps.length;
    const KEY = `walk-step:${location.pathname}`;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let n = 1;
    try {
      const saved = parseInt(localStorage.getItem(KEY) ?? '0', 10);
      if (saved > 1) n = Math.min(saved, total + 1);
    } catch (e) {}

    flow.classList.add('walk');
    ctl.hidden = false;
    const view = (el: HTMLElement) => el.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
    const replay = (el: HTMLElement) => {
      el.classList.remove('reveal');
      void el.offsetWidth;   /* restart the animation */
      el.classList.add('reveal');
    };
    function render(animate: boolean) {
      try { localStorage.setItem(KEY, String(n)); } catch (e) {}
      steps.forEach((s, i) => {
        s.hidden = i >= n;
        /* the last revealed step draws no connector: nothing follows it yet */
        s.classList.toggle('linked', i < n - 1);
        if (animate && i === n - 1) replay(s);
      });
      const done = n > total;
      answer.hidden = !done;
      if (done) {
        steps[total - 1]?.classList.add('linked');
        if (animate) replay(answer);
        if (count) count.textContent = 'All steps done';
        if (label) label.textContent = 'Restart';
        if (allBtn) allBtn.hidden = true;
      } else {
        if (count) count.textContent = `Step ${n} of ${total}`;
        if (label) label.textContent = n === total ? 'Show answer' : 'Next step';
        if (allBtn) allBtn.hidden = false;
      }
      dots.forEach((d, i) => d.classList.toggle('on', i < Math.min(n, total)));
      const arrow = nextBtn.querySelector('svg');
      if (arrow) (arrow as SVGElement).style.display = done ? 'none' : '';
    }
    nextBtn.addEventListener('click', () => {
      if (n > total) {
        n = 1;
        render(false);
        flow.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
        return;
      }
      n += 1;
      render(true);
      view(n > total ? answer : steps[n - 1]);
    });
    allBtn.addEventListener('click', () => {
      n = total + 1;
      render(true);
      view(answer);
    });
    /* the resume snackbar (a later step) resets the walkthrough through this */
    (window as any).walkReset = () => { n = 1; render(false); };
    render(false);
  })();
</script>
