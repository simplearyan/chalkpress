---
// Base layout: fonts, theme boot, and the full SEO/social meta block
// (OG + Twitter + canonical + favicon).
//
// Math is NOT typeset here: it is rendered into the markup at build time
// (lib/math.js), so there is nothing to swap in after paint. All this layout
// needs is KaTeX's stylesheet, which ships from the bundle — the fonts are
// emitted locally too, so a refresh makes no third-party request at all.
import 'katex/dist/katex.min.css';
import '../styles/site.css';
interface Props {
  title: string;
  description?: string;
  /** Site-root-relative path to the social card image; must exist in public/ */
  ogImage?: string;
}
const {
  title,
  description = 'Short-form math explainers — every problem worked in full, then repackaged as a short with script, animation, and copyable code.',
  ogImage = '/og-default.png',
} = Astro.props;

/* Canonical + absolute OG URLs need the deploy origin. Astro.site is set in
   astro.config.mjs (env SITE); base (env BASE) prefixes asset paths on
   project-pages deploys (https://owner.github.io/repo/). */
const site = Astro.site ?? new URL('https://iitm.example.com');
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
/* With a base, Astro.url.pathname already carries it (/repo/subject/id/). */
const canonical = new URL(Astro.url.pathname, site).href;
const ogUrl = new URL(base + ogImage, site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- canonical + robots -->
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="IITM Shorts" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:alt" content={`${title} — animation frame`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />

  <!-- theme + icons (favicon art: public/meta-src/README.md experiment) -->
  <meta name="theme-color" content="#0e1512" />
  <!-- no-FOUC theme boot: runs synchronously in <head>, BEFORE first paint.
       Persisted choice ('hic_theme', shared with the studio pages) wins over
       the OS preference; the browser default is dark to match the mock. -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('hic_theme');
        var dark = saved === 'dark' || (saved !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        var mc = document.querySelector('meta[name="theme-color"]');
        if (mc) mc.setAttribute('content', dark ? '#0f1512' : '#f5f4ee');

        /* Seed the section highlight so the FIRST frame is already correct. The
           browser restores the scroll position after this runs, so a script
           that asked the DOM which section is on screen would paint "Work the
           problem" and then flip to "Build the short". An explicit #part- hash
           wins; otherwise, whatever section this page last ended on. */
        var seed = (location.hash || '').replace(/^#part-/, '');
        if (!seed) {
          var last = localStorage.getItem('hic_tab:' + location.pathname);
          if (last) {
            seed = last;
            /* a remembered section other than the first means the page came
               back scrolled, so the bar's hairline belongs from the start */
            if (last !== 'solve') document.documentElement.classList.add('scrolled');
          }
        }
        document.documentElement.setAttribute('data-tab-init', seed || 'solve');
      } catch (e) {}
    })();
  </script>
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
  <link rel="icon" type="image/png" sizes="64x64" href={`${base}/favicon-64.png`} />
  <link rel="apple-touch-icon" href={`${base}/favicon-64.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- families, weights and the pairings match the reference mock:
       Google Sans Flex for UI, Literata for display, Roboto Mono for data.
       Never write a family at a call site — use --sans / --serif / --mono. -->
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=Google+Sans+Flex:wght@400;500;600&family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
  <!-- one shared snackbar: copy confirmations now, the resume action in phase 4 -->
  <div id="snack" role="status" aria-live="polite"></div>
  <script>
    // smooth scrolling for in-page anchors only (stepper links etc.). CSS
    // scroll-behavior stays 'auto' so the browser's scroll RESTORATION on
    // refresh jumps instantly instead of animating from the top (flicker).
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;
      const href = a.getAttribute('href');
      if (!href || href.length < 2) return;
      const el = document.querySelector(href);
      if (!el) return;
      e.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      history.pushState(null, '', href);
      /* the default jump — which moves focus with it — is prevented above, so
         move sequential focus to the target ourselves; this is what makes the
         skip link actually skip */
      if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
      el.focus({ preventScroll: true });
    });

    // ── app shell ───────────────────────────────────────────────────────
    // 1. hairline on the app bar only once content is under it, and the
    //    phone-only "slide the bar away" behaviour (CSS neutralises it ≥720px).
    // 2. one scroll-spy drives both the segmented tabs and the bottom nav —
    //    they share data-tab, so neither component needs to know about the other.
    (function () {
      const root = document.documentElement;
      let last = window.scrollY, ticking = false;
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = Math.max(0, window.scrollY);
          const d = y - last;
          root.classList.toggle('scrolled', y > 4);
          if (y < 80) root.classList.remove('nav-hidden');
          else if (d > 6) root.classList.add('nav-hidden');
          else if (d < -6) root.classList.remove('nav-hidden');
          if (Math.abs(d) > 6) last = y;
          ticking = false;
        });
      }, { passive: true });
      // leaving phone width: the bar is always visible again, so drop the
      // scroll-hidden state instead of letting it linger into the layout
      const wide = window.matchMedia('(min-width: 720px)');
      wide.addEventListener('change', (e) => { if (e.matches) root.classList.remove('nav-hidden'); });
    })();

    (function () {
      const root = document.documentElement;
      const links = [...document.querySelectorAll('[data-tab]')];
      const secs = [...document.querySelectorAll('[id^="part-"]')];
      if (!links.length || !secs.length) return;
      const KEY = 'hic_tab:' + location.pathname;
      const idOf = (el) => el.id.replace(/^part-/, '');
      /* start from whatever the head boot seeded; that value is already painted
         by CSS, so this only has to agree with it */
      let cur = root.getAttribute('data-tab-init') || idOf(secs[0]);
      const paint = () => {
        for (const l of links) {
          const on = l.dataset.tab === cur;
          l.classList.toggle('active', on);
          /* assistive tech needs the current item announced, not just painted */
          if (on) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        }
      };
      const spy = () => {
        const line = window.innerHeight * 0.4;
        let next = idOf(secs[0]);
        for (const s of secs) if (s.getBoundingClientRect().top <= line) next = idOf(s);
        // the last section is short — reaching the bottom counts as being in it
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
          next = idOf(secs[secs.length - 1]);
        }
        if (next === cur) return;
        cur = next;
        paint();
        /* remembered so the next visit can paint the right section immediately */
        try { localStorage.setItem(KEY, cur); } catch (e) {}
      };
      paint();
      if (location.hash) {
        spy();
      } else {
        /* Wait for load: that is when the restored scroll position is real. A
           spy call now would read the top of the page and undo the seed. Any
           scroll in the meantime still reports through the listener below. */
        window.addEventListener('load', () => requestAnimationFrame(spy), { once: true });
      }
      window.addEventListener('scroll', spy, { passive: true });
      window.addEventListener('resize', spy);
    })();

    // toggle wiring only — data-theme was already set inline in <head> before
    // first paint (no flash of the wrong theme on refresh). Same 'hic_theme'
    // key as the studio pages, so site and editor agree.
    (function () {
      const root = document.documentElement;
      const setMeta = (t) => {
        const mc = document.querySelector('meta[name="theme-color"]');
        if (mc) mc.setAttribute('content', t === 'dark' ? '#0f1512' : '#f5f4ee');
      };
      // keep in sync if another tab flips the theme
      window.addEventListener('storage', (e) => {
        if (e.key === 'hic_theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
          root.setAttribute('data-theme', e.newValue);
          setMeta(e.newValue);
        }
      });
      const btn = document.getElementById('theme-toggle');
      if (btn) btn.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('hic_theme', next); } catch (e) {}
        setMeta(next);
      });
    })();

    /* Refresh flicker, part 2: scroll restoration is instant now, but KaTeX
       math + lazy webfonts keep changing layout for a moment after load, so
       the restored/anchored position drifts ("flickers"). For a short settle
       window we pin an anchor element to its viewport offset and re-snap each
       frame while layout shifts; any user input releases the pin. */
    (function settle() {
      const hasHash = location.hash && location.hash.length > 1;
      if (!hasHash && window.scrollY < 2) return; /* fresh top visit: nothing to hold */
      let userMoved = false;
      const mark = () => { userMoved = true; };
      ['wheel', 'touchstart', 'keydown'].forEach((ev) =>
        window.addEventListener(ev, mark, { passive: true, once: true }));

      const t0 = performance.now();
      let pinned = null, off0 = 0;
      /* the hash target must clear the sticky app bar, exactly like
         scroll-padding-top does for anchor clicks — pinning it to 0 would slide
         the heading under the bar on a reload */
      function barOffset() {
        return parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      }
      function acquire() {
        if (hasHash) {
          const el = document.querySelector(location.hash);
          if (el) { pinned = el; off0 = barOffset(); el.scrollIntoView({ behavior: 'auto', block: 'start' }); }
          return !!el;
        }
        const y = window.scrollY;
        for (const el of document.querySelectorAll('section, .step, .card, h2, h3, p, li')) {
          const r = el.getBoundingClientRect();
          if (r.height > 0 && r.top >= -24 && r.top <= 40) {
            pinned = el; off0 = r.top; return true;
          }
        }
        return false;
      }
      function tick() {
        if (userMoved || performance.now() - t0 > 2500) return;
        if (!pinned || !pinned.isConnected) { if (!acquire()) { requestAnimationFrame(tick); return; } }
        const top = pinned.getBoundingClientRect().top;
        const drift = top - off0;
        if (Math.abs(drift) > 1) window.scrollTo(0, window.scrollY + drift);
        requestAnimationFrame(tick);
      }
      acquire();
      requestAnimationFrame(tick);
    })();
  </script>
  <script>
    /* One shared snackbar, exposed on window: Player's inline classic script
       cannot import modules, and every handler that calls it runs long after
       this module has executed. Optional action button = escape hatch (phase 4
       wires "Start over" to it). */
    const snack = document.getElementById('snack') as HTMLElement;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    (window as unknown as { __snack: (msg: string, action?: string, fn?: () => void, ms?: number) => void })
      .__snack = (msg, action, fn, ms) => {
        snack.textContent = msg;
        if (action) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'snack-act';
          b.textContent = action;
          b.addEventListener('click', () => { fn?.(); snack.classList.remove('show'); });
          snack.appendChild(b);
        }
        snack.classList.add('show');
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(() => snack.classList.remove('show'), ms || 2000);
      };
  </script>
</body>
</html>
