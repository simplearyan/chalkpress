---
// Animation player — the SAME preview engine as test-renderer: hic-frame's
// HicRenderer rasterizes the compiled storyboard clip (SVG foreignObject with
// KaTeX/Tailwind/font embedding) into a canvas, wall-clock playback + scrub.
// Copy actions emit test-renderer's exact paste format (fenced blocks with
// <title> + <!-- ds --> + <!-- dur --> markers), so code copied here pastes
// seamlessly into test-renderer's AI tab — code, name, aspect AND duration.
//
// Chrome follows the reference mock's device card: a tonal card whose only dark
// surface is the frame, an aspect pill, a fullscreen toggle and the product
// actions (copy code / AI prompt / renderer) in one bar, 44px round controls
// with a glyph per data-state in the transport row, and nothing else between the
// picture and the script. Fullscreen turns the CARD into a void with the picture
// centred in it — see the CSS block, which also says why it is the card and not
// the frame.
import { compileStoryboard } from '../../../runtime/hic-storyboard.esm.js';
import { clipToFenced, buildAiPrompt } from '../lib/animation-prompt.js';
import { base } from '../lib/url.js';

interface Props { storyboard: object; id?: string; prompt?: string; }
const { storyboard, id = 'stage', prompt = '' } = Astro.props;

const clip = compileStoryboard(storyboard);
const ds = clip.ds || '16:9';
const durMs = Math.round((clip.dur || 15) * 1000);
const title = clip.name || storyboard.id || 'Storyboard';
const fenced = clipToFenced({ title, ds, durMs, html: clip.html, css: clip.css, js: clip.js });
const fullPrompt = buildAiPrompt(prompt || ('Recreate the "' + title + '" explainer short.'), durMs, ds);
/* The fenced payload carries literal </script> (KaTeX CDN tags) — ship it as
   \u003c-escaped JSON (valid inside a <script> island) and parse at boot. */
const fencedJson = JSON.stringify(fenced).replace(/</g, '\\u003c');
/* Vendor script + deep-link path must respect the deploy base (Pages) — see
   lib/url.js, which is the single place that knows it. */

/* "0:15" for the static total in the timecode row */
const totalSecs = Math.round(durMs / 1000);
const totalLabel = `${Math.floor(totalSecs / 60)}:${String(totalSecs % 60).padStart(2, '0')}`;
const [cw, ch] = ds === '9:16' ? [450, 800] : [800, 450];
---
<section
  class="stage-shell"
  data-title={title}
  data-ds={ds}
  data-dur={durMs}
  data-state="idle"
  data-aspect={ds}
>
  {/* one chrome row, not three: the frame control and the product actions live
      in the bar, so the only rows between the picture and the script are this
      bar and the transport. The tools keep `title`/`aria-label` and are icon
      buttons here (see .tool-btn) — always visible, never hover-gated. */}
  <div class="stage-bar">
    {/* the label is one word because the bar now carries the controls too:
        "Animation preview" is 130px of mono, and at the 345px column the
        900px tier resolves to, that one word is what decides whether the bar
        is one 44px line or two. The section heading and the intro line above
        the card already say "preview" — see IITM-DESIGN-PLAN.md §11 Phase 12. */}
    <span class="label">Preview</span>
    <button
      id="btn-aspect"
      class="btn-aspect"
      type="button"
      aria-pressed={ds === '9:16' ? 'false' : 'true'}
      title={ds === '9:16' ? 'Show the frame in 16:9' : 'Show the frame in 9:16'}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="7" y="3" width="10" height="18" rx="2" />
      </svg>
      <span class="aspect-label">{ds}</span>
    </button>
    <div class="stage-tools">
      <button id="btn-copy-code" class="tool-btn" type="button"
        title="Copy animation code in test-renderer paste format (HTML/CSS/JS + duration)"
        aria-label="Copy animation code">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
      </button>
      <button id="btn-copy-prompt" class="tool-btn" type="button"
        title="Copy the AI prompt that regenerates this animation (works in test-renderer too)"
        aria-label="Copy AI prompt">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
      </button>
      <button id="btn-open-tr" class="tool-btn" type="button"
        title="Open this storyboard in test-renderer (same engine, WebM export, full editor)"
        aria-label="Open in renderer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
      </button>
    </div>
    {/* fullscreen: the frame's own size control, so it sits with the aspect
        pill rather than the product actions. Two glyphs, swapped by CSS on
        [data-fs] — same pattern as the play/pause/replay glyphs. */}
    <button id="btn-fs" class="tool-btn btn-fs" type="button" aria-pressed="false"
      aria-keyshortcuts="F" aria-label="Fullscreen" title="Fullscreen (F)">
      <svg class="i-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3" /><path d="M16 3h3a2 2 0 0 1 2 2v3" /><path d="M16 21h3a2 2 0 0 0 2-2v-3" /><path d="M8 21H5a2 2 0 0 1-2-2v-3" /></svg>
      <svg class="i-compress" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3" /><path d="M16 3v3a2 2 0 0 0 2 2h3" /><path d="M16 21v-3a2 2 0 0 1 2-2h3" /><path d="M8 21v-3a2 2 0 0 0-2-2H3" /></svg>
    </button>
  </div>

  <div class="stage-holder">
    {/* The frame is a tab stop so `F` has something to act on and the picture
        is reachable without a pointer; `aria-keyshortcuts` advertises it. */}
    <div class="stage-frame" id="stage-frame" data-aspect={ds} tabindex="0"
      role="img" aria-keyshortcuts="F">
      <canvas id={id} data-aspect={ds} width={cw} height={ch}></canvas>
      <button id="stage-play" class="stage-play" type="button" tabindex="-1" aria-hidden="true">
        <span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></span>
      </button>
    </div>
  </div>

  <div class="progress-track" id="progress-track">
    <div class="progress-fill" id="progress-fill"></div>
    <input id="scrubber" type="range" min="0" max="1000" value="0" step="1" aria-label="Seek">
  </div>

  <div class="ctl-row">
    <button id="btn-play" class="pl-btn" type="button" aria-label="Play" title="Play" aria-keyshortcuts="K">
      <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
      <svg class="i-replay" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z" /></svg>
    </button>
    <span class="time"><span id="t-cur">0:00</span><span class="dim"> / {totalLabel}</span></span>
    <span class="grow"></span>
    {/* keyboard discoverability, folded into this row's dead space so it costs
        no height — CSS shows it on fine pointers at ≥720px only (spec §7). The
        arrows refer to the focused native range (the scrubber). */}
    <span class="ctl-hint" title="K: play / pause · R: restart · F: fullscreen · arrow keys: seek">
      <kbd>K</kbd> <kbd>R</kbd> <kbd class="h-f">F</kbd> <kbd>←</kbd><kbd>→</kbd>
    </span>
    <button id="btn-reset" class="pl-btn" type="button" aria-label="Restart from beginning" title="Restart" aria-keyshortcuts="R">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" /></svg>
    </button>
  </div>
</section>

<!-- test-renderer's preview engine (HicRenderer): same SVG-foreignObject renderer,
     KaTeX/Tailwind/font embedding and frame math as the editor's canvas -->
<script is:inline src={`${base}/vendor/hic-frame.js`}></script>
<script type="application/json" id="storyboard-data" set:html={JSON.stringify(storyboard).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="hic-fenced-data" set:html={fencedJson}></script>

<script define:vars={{ ds, durMs, title, base, fullPrompt }}>
  /* Boot test-renderer's preview engine (HicRenderer, vendored above) on the
     compiled storyboard clip. Module-adjacent classic script: hic-frame.js is a
     plain <script src> earlier in the document, so the factory is global. */
  (async function boot() {
    const shell = document.querySelector('.stage-shell');
    const stage = document.getElementById('stage');
    const frame = document.getElementById('stage-frame');
    const btnPlay = document.getElementById('btn-play');
    const scrubber = document.getElementById('scrubber');
    const progressFill = document.getElementById('progress-fill');
    const tCur = document.getElementById('t-cur');
    const fenced = JSON.parse(document.getElementById('hic-fenced-data').textContent);

    /* parse our fenced payload → {html, css, js} for HicRenderer.setClip.
       (Mirrors test-renderer's aiParseReply for the 3-block format we emit.) */
    function parseFenced(text) {
      const res = { html: '', css: '', js: '' };
      const fenceRe = /```([a-zA-Z0-9]*)[ \t]*\n([\s\S]*?)```/g;
      let m;
      while ((m = fenceRe.exec(text)) !== null) {
        const lang = (m[1] || '').toLowerCase();
        if (lang === 'css') res.css += (res.css ? '\n\n' : '') + m[2].trim();
        else if (lang === 'js' || lang === 'javascript') res.js += (res.js ? '\n\n' : '') + m[2].trim();
        else res.html += (res.html ? '\n\n' : '') + m[2].trim();
      }
      return res;
    }

    const parsed = parseFenced(fenced);
    /* The clip's own KaTeX tags point at jsDelivr so the copy-paste payload stays
       portable — `fenced` is what Copy code emits and is left untouched. For the
       PREVIEW they are pointed at the copy shipped in public/vendor/katex (same
       0.16.11): a refresh used to fetch katex.min.js, auto-render.min.js and ~60
       font files from the CDN before the first frame could be drawn, and hoisted
       those two scripts into this page's own <head>. Note the replacement is
       ABSOLUTE, not root-relative: the engine's asset inliner only rewrites
       http(s) stylesheet links, and a relative one would be left in the clip with
       its fonts un-inlined, i.e. the frame's math on fallback metrics. */
    const VK = location.origin + base + '/vendor/katex/';
    const localize = (s) => String(s || '').replace(/https:\/\/cdn\.jsdelivr\.net\/npm\/katex@[\d.]+\/dist\//g, VK);
    parsed.html = localize(parsed.html);
    parsed.css = localize(parsed.css);
    parsed.js = localize(parsed.js);

    /* ── the reader's aspect for this question, applied HERE and synchronously.
          It used to ride on the aspect button's click at the END of this
          function, i.e. after setClip's awaits: a refresh painted the frame at
          the COMPILED aspect and only resized it once that work finished, so
          ~290px of the page below the preview moved after paint. A frame is
          280x498 as 9:16 and ~380x205 as 16:9, so the jump landed right under
          the reader's eyes. Setting it before the renderer exists also means one
          rasterisation, not two. ── */
    let aspect = ds;
    try {
      const saved = sessionStorage.getItem('iitmAspect:' + location.pathname);
      if (saved === '9:16' || saved === '16:9') aspect = saved;
    } catch (e) {}
    if (aspect !== ds) {
      const restoreBtn = document.getElementById('btn-aspect');
      shell.dataset.aspect = aspect;
      frame.dataset.aspect = aspect;
      stage.dataset.aspect = aspect;
      if (restoreBtn) {
        restoreBtn.setAttribute('aria-pressed', aspect === '16:9' ? 'true' : 'false');
        restoreBtn.title = aspect === '9:16' ? 'Show the frame in 16:9' : 'Show the frame in 9:16';
        const lbl = restoreBtn.querySelector('.aspect-label');
        if (lbl) lbl.textContent = aspect;
      }
    }
    let sw = aspect === '9:16' ? 450 : 800;
    let sh = aspect === '9:16' ? 800 : 450;
    stage.width = sw; stage.height = sh;
    const ctx = stage.getContext('2d');
    const fmt = (ms) => {
      const s = Math.floor(ms / 1000);
      return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    };

    let renderer = window.makeHicRenderer(sw, sh, sw, sh);
    await renderer.setClip(parsed.html, parsed.css, parsed.js);

    /* data-state drives which glyph the play button shows and whether the
       on-frame overlay is visible (CSS) */
    const LABELS = { idle: 'Play', playing: 'Pause', paused: 'Resume', done: 'Replay' };
    function setState(s) {
      shell.dataset.state = s;
      btnPlay.setAttribute('aria-label', LABELS[s]);
      btnPlay.title = LABELS[s];
    }

    /* ── wall-clock playback, same model as hic-modal / hic-scenes ── */
    let playing = false, raf = 0, wallStart = 0, tAtStart = 0, t = 0;
    function drawAt(ms) {
      renderer.renderFrame(ms).then((ok) => { if (ok) renderer.drawTo(ctx, 0, 0, sw, sh); });
      tCur.textContent = fmt(ms);
      scrubber.value = String(Math.round(ms / durMs * 1000));
      progressFill.style.width = (ms / durMs * 100) + '%';
    }
    function loop(now) {
      if (!playing) return;
      t = tAtStart + (now - wallStart);
      if (t >= durMs) {
        drawAt(durMs);
        pause();
        setState('done');
        return;
      }
      drawAt(t);
      raf = requestAnimationFrame(loop);
    }
    function play() {
      if (playing) return;
      if (t >= durMs) t = 0;
      playing = true;
      setState('playing');
      wallStart = performance.now();
      tAtStart = t;
      raf = requestAnimationFrame(loop);
    }
    function pause() {
      playing = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      if (shell.dataset.state === 'playing') setState('paused');
    }
    btnPlay.addEventListener('click', () => (playing ? pause() : play()));
    document.getElementById('stage-play').addEventListener('click', () => (playing ? pause() : play()));
    document.getElementById('btn-reset').addEventListener('click', () => {
      pause(); t = 0; drawAt(0); setState('idle');
    });
    scrubber.addEventListener('input', () => {
      pause();
      t = (parseFloat(scrubber.value) / 1000) * durMs;
      drawAt(t);
    });
    drawAt(0);   /* first frame onto the canvas */

    /* ── haptics: a tick on play and a softer one on restart (mock) ── */
    btnPlay.addEventListener('click', () => { if (navigator.vibrate) navigator.vibrate(12); });
    document.getElementById('btn-reset').addEventListener('click', () => { if (navigator.vibrate) navigator.vibrate(8); });

    /* ── K / R shortcuts: only while the card is on screen, never while typing,
          never with modifiers held. Visibility is measured from the rect at press
          time rather than an IntersectionObserver — same gate, exact, no observer
          to starve — and arrow seeking stays on the focused native range so page
          scroll and the scrubber's own keyboard support keep working. ── */
    addEventListener('keydown', (e) => {
      if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
      const g = e.target;
      if (g && (/^(INPUT|TEXTAREA|SELECT)$/.test(g.tagName) || g.isContentEditable)) return;
      const k = e.key.toLowerCase();
      if (k !== 'k' && k !== 'r' && k !== 'f') return;
      const r = shell.getBoundingClientRect();
      const visible = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
      if (visible < Math.min(r.height, innerHeight) * 0.4) return;
      e.preventDefault();
      if (k === 'k') btnPlay.click();
      else if (k === 'f') { shell.dataset.fs ? exitFs() : enterFs(); }
      else {
        const was = shell.dataset.state === 'playing';
        document.getElementById('btn-reset').click();
        if (was) btnPlay.click();
      }
    });

    /* ── fullscreen (phase 12.4). The CSS block explains why the CARD is what
          expands; this is the state machine. Two mechanisms, one state: the real
          Fullscreen API where it exists, and a scroll-locked fixed overlay where
          it does not (iOS refuses element fullscreen for anything but <video>).
          `data-fs` is what the CSS, aria-pressed and the glyph are keyed to, so
          both paths stay in step — and a browser without :fullscreen support
          still gets the whole feature. ── */
    const btnFs = document.getElementById('btn-fs');
    let fsScroll = 0, fsWatch = 0;
    function setFs(mode) {
      if (mode) shell.dataset.fs = mode;
      else delete shell.dataset.fs;
      /* the scroll lock belongs to the fixed overlay, never to real fullscreen */
      document.documentElement.style.overflow = mode === 'fixed' ? 'hidden' : '';
      btnFs.setAttribute('aria-pressed', mode ? 'true' : 'false');
      btnFs.setAttribute('aria-label', mode ? 'Exit fullscreen' : 'Fullscreen');
      btnFs.title = mode ? 'Exit fullscreen (F)' : 'Fullscreen (F)';
    }
    function fixedFs() {
      clearTimeout(fsWatch);
      setFs('fixed');
      frame.focus({ preventScroll: true });
    }
    function enterFs() {
      if (shell.dataset.fs) return;
      /* the shell leaves the flow while it is fullscreen, so the document gets
         shorter behind it — remember where the reader was before that */
      fsScroll = window.scrollY;
      /* The overlay is what the click gets, immediately. Real fullscreen is an
         UPGRADE on top of it: while an async request is pending the reader is
         already looking at the expanded card, so a slow or refused request can
         never leave a button that appears to do nothing. Never awaited — a
         request that neither resolves nor rejects (the Freebuff preview webview
         does exactly that) must not strand the reader outside the feature. */
      fixedFs();
      if (!(document.fullscreenEnabled && shell.requestFullscreen)) return;
      let req = null;
      try { req = shell.requestFullscreen(); } catch (e) { return; }
      if (req && req.catch) req.catch(() => {});
    }
    function exitFs() {
      if (shell.dataset.fs === 'native' && document.fullscreenElement) {
        const req = document.exitFullscreen();
        if (req && req.catch) req.catch(leaveFs);
        return;
      }
      leaveFs();
    }
    function leaveFs() {
      clearTimeout(fsWatch);
      /* a request that landed after the reader already left would otherwise put
         them back in fullscreen with the overlay's state already cleared */
      if (document.fullscreenElement === shell && document.exitFullscreen) {
        try { const r = document.exitFullscreen(); if (r && r.catch) r.catch(() => {}); } catch (e) {}
      }
      setFs(null);
      if (fsScroll) { window.scrollTo(0, fsScroll); fsScroll = 0; }
      btnFs.focus({ preventScroll: true });   /* back to the control that opened it */
    }
    /* Esc (and the browser's own exit affordance) reach us here, not through
       the button: entering moves focus into the frame, which is what F acts on */
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement === shell) {
        setFs('native');
        frame.focus({ preventScroll: true });
      } else if (shell.dataset.fs === 'native') leaveFs();
    });
    btnFs.addEventListener('click', () => (shell.dataset.fs ? exitFs() : enterFs()));
    /* double-click the picture — the reference's other fullscreen gesture */
    frame.addEventListener('dblclick', () => { shell.dataset.fs ? exitFs() : enterFs(); });
    /* the fixed overlay has no native Esc handling of its own */
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && shell.dataset.fs === 'fixed') { e.preventDefault(); leaveFs(); }
    });

    /* ── aspect: re-frame the preview (the clip is re-rasterised at the new
          size, so there is never a stretched bitmap) ── */
    const btnAspect = document.getElementById('btn-aspect');
    const aspectLabel = btnAspect.querySelector('.aspect-label');
    let framing = false;
    btnAspect.addEventListener('click', async () => {
      if (framing) return;
      framing = true;
      const wide = shell.dataset.aspect === '9:16';
      const next = wide ? '16:9' : '9:16';
      shell.dataset.aspect = next;
      frame.dataset.aspect = next;
      stage.dataset.aspect = next;
      aspectLabel.textContent = next;
      btnAspect.setAttribute('aria-pressed', next === '16:9' ? 'true' : 'false');
      btnAspect.title = wide ? 'Show the frame in 9:16' : 'Show the frame in 16:9';
      sw = next === '9:16' ? 450 : 800;
      sh = next === '9:16' ? 800 : 450;
      stage.width = sw; stage.height = sh;
      try { sessionStorage.setItem('iitmAspect:' + location.pathname, next); } catch (e) {}
      const wasPlaying = playing;
      if (wasPlaying) pause();
      renderer = window.makeHicRenderer(sw, sh, sw, sh);
      await renderer.setClip(parsed.html, parsed.css, parsed.js);
      drawAt(t);
      framing = false;
      if (wasPlaying) play();
    });
    /* the saved aspect was already applied before the first raster — see the
       synchronous restore at the top of boot() */

    /* ── copy actions: TR paste format + the regenerating AI prompt ── */
    /* label swap + snackbar; falls back to execCommand where the async
       clipboard API is unavailable (non-secure context / automation) */
    function copyText(text, btn, okMs) {
      const done = () => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), okMs || 1600);
        if (window.__snack) window.__snack('Copied to clipboard');
      };
      const fallback = () => {
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
        document.body.removeChild(ta);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(fallback);
      } else fallback();
    }
    document.getElementById('btn-copy-code').addEventListener('click', function () { copyText(fenced, this); });
    document.getElementById('btn-copy-prompt').addEventListener('click', function () { copyText(fullPrompt, this, 2200); });

    /* Open in Renderer: #storyboard= deep link (TR compiles + opens the clip).
       Default path assumes TR is served from the same origin (vite serving
       design_concepts/); override with localStorage 'iitmTrUrl' when the
       site and the editor live on different hosts. */
    document.getElementById('btn-open-tr').addEventListener('click', () => {
      const sbEl = document.getElementById('storyboard-data');
      if (!sbEl) return;
      const b64 = btoa(unescape(encodeURIComponent(sbEl.textContent)))
        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      let trBase = '/studios/studio-pro-editor/docs/html-in-canvas/test-renderer.html';
      try { trBase = localStorage.getItem('iitmTrUrl') || trBase; } catch (e) {}
      window.open(trBase + '#storyboard=' + b64, '_blank');
      void base; /* available for origin-relative TR deployments */
      void title;
    });

    window.__hicFenced = fenced;   /* debug/verification handle */
    window.__hicSeek = (ms) => { pause(); t = ms; drawAt(ms); };
  })();
</script>
