---
// Animation player — the SAME preview engine as test-renderer: hic-frame's
// HicRenderer rasterizes the compiled storyboard clip (SVG foreignObject with
// KaTeX/Tailwind/font embedding) into a canvas, wall-clock playback + scrub.
// Copy actions emit test-renderer's exact paste format (fenced blocks with
// <title> + <!-- ds --> + <!-- dur --> markers), so code copied here pastes
// seamlessly into test-renderer's AI tab — code, name, aspect AND duration.
import { compileStoryboard } from '../../../runtime/hic-storyboard.esm.js';
import { clipToFenced, buildAiPrompt } from '../lib/animation-prompt.js';

interface Props { storyboard: object; id?: string; prompt?: string; }
const { storyboard, id = 'stage', prompt = '' } = Astro.props;

const clip = compileStoryboard(storyboard);
const ds = clip.ds || '16:9';
const durMs = Math.round((clip.dur || 15) * 1000);
const title = clip.name || storyboard.id || 'Storyboard';
const fenced = clipToFenced({ title, ds, durMs, html: clip.html, css: clip.css, js: clip.js });
const fullPrompt = buildAiPrompt(prompt || ('Recreate the "' + title + '" explainer short.'), durMs, ds);
/* The fenced payload carries literal </script> (KaTeX CDN tags) — ship it as
   \u003c-escaped JSON (valid inside a <script> island) and parse at boot. */
const fencedJson = JSON.stringify(fenced).replace(/</g, '\\u003c');
/* Vendor script + deep-link path must respect the deploy base (Pages). */
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="stage-shell" data-title={title} data-ds={ds} data-dur={durMs}>
  <div class="stage-bar">
    <span class="label">Animation preview</span>
    <span class="stage-controls">
      <button id="btn-copy-code" title="Copy animation code in test-renderer paste format (HTML/CSS/JS + duration)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span class="lbl-default">Copy code</span><span class="lbl-copied">Copied!</span>
      </button>
      <button id="btn-copy-prompt" title="Copy the AI prompt that regenerates this animation (works in test-renderer too)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        <span>AI prompt</span>
      </button>
      <button id="btn-open-tr" title="Open this storyboard in test-renderer (same engine, WebM export, full editor)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span>Renderer</span>
      </button>
      <button id="btn-play">Play</button>
      <button id="btn-reset">Reset</button>
    </span>
  </div>
  <div class="stage-holder">
    <canvas id={id} data-aspect={ds} width="800" height="450"></canvas>
  </div>
  <div class="scrub-row">
    <span class="scrub-time" id="t-cur">0:00</span>
    <input id="scrubber" type="range" min="0" max="1000" value="0" step="1" aria-label="Scrub timeline">
    <span class="scrub-time" id="t-total">0:00</span>
  </div>
</div>

<!-- test-renderer's preview engine (HicRenderer): same SVG-foreignObject renderer,
     KaTeX/Tailwind/font embedding and frame math as the editor's canvas -->
<script is:inline src={`${base}/vendor/hic-frame.js`}></script>
<script type="application/json" id="storyboard-data" set:html={JSON.stringify(storyboard).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="hic-fenced-data" set:html={fencedJson}></script>

<script define:vars={{ ds, durMs, title, base, fullPrompt }}>
  /* Boot test-renderer's preview engine (HicRenderer, vendored above) on the
     compiled storyboard clip. Module-adjacent classic script: hic-frame.js is
     a plain <script src> earlier in the document, so the factory is global. */
  (async function boot() {
    const stage = document.getElementById('stage');
    const btnPlay = document.getElementById('btn-play');
    const scrubber = document.getElementById('scrubber');
    const tCur = document.getElementById('t-cur');
    const tTotal = document.getElementById('t-total');
    const fenced = JSON.parse(document.getElementById('hic-fenced-data').textContent);

    /* parse our fenced payload → {html, css, js} for HicRenderer.setClip.
       (Mirrors test-renderer's aiParseReply for the 3-block format we emit.) */
    function parseFenced(text) {
      const res = { html: '', css: '', js: '' };
      const fenceRe = /```([a-zA-Z0-9]*)[ \t]*\n([\s\S]*?)```/g;
      let m;
      while ((m = fenceRe.exec(text)) !== null) {
        const lang = (m[1] || '').toLowerCase();
        const code = m[2].trim();
        if (lang === 'css') res.css += (res.css ? '\n\n' : '') + code;
        else if (lang === 'js' || lang === 'javascript') res.js += (res.js ? '\n\n' : '') + code;
        else res.html += (res.html ? '\n' : '') + code;
      }
      return res;
    }

    const parsed = parseFenced(fenced);
    const [sw, sh] = ds === '9:16' ? [450, 800] : [800, 450];
    stage.width = sw; stage.height = sh;
    const ctx = stage.getContext('2d');
    const fmt = (ms) => { const s = Math.floor(ms / 1000); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };

    const renderer = window.makeHicRenderer(sw, sh, sw, sh);
    await renderer.setClip(parsed.html, parsed.css, parsed.js);

    /* ── wall-clock playback, same model as hic-modal / hic-scenes ── */
    let playing = false, raf = 0, wallStart = 0, tAtStart = 0, t = 0;
    function drawAt(ms) {
      renderer.renderFrame(ms).then((ok) => { if (ok) renderer.drawTo(ctx, 0, 0, sw, sh); });
      tCur.textContent = fmt(ms);
      scrubber.value = String(Math.round(ms / durMs * 1000));
    }
    function loop(now) {
      if (!playing) return;
      t = tAtStart + (now - wallStart);
      if (t >= durMs) {
        drawAt(durMs);
        pause();
        btnPlay.textContent = 'Replay';
        return;
      }
      drawAt(t);
      raf = requestAnimationFrame(loop);
    }
    function play() {
      if (playing) return;
      if (t >= durMs) t = 0;
      playing = true;
      btnPlay.textContent = 'Pause';
      wallStart = performance.now();
      tAtStart = t;
      raf = requestAnimationFrame(loop);
    }
    function pause() {
      playing = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }
    btnPlay.addEventListener('click', () => (playing ? pause() : play()));
    document.getElementById('btn-reset').addEventListener('click', () => { pause(); t = 0; drawAt(0); btnPlay.textContent = 'Play'; });
    scrubber.addEventListener('input', () => {
      pause();
      t = (parseFloat(scrubber.value) / 1000) * durMs;
      drawAt(t);
    });
    tTotal.textContent = fmt(durMs);
    drawAt(0);   /* first frame onto the canvas */

    /* ── copy actions: TR paste format + the regenerating AI prompt ── */
    function copyText(text, btn, okMs) {
      navigator.clipboard.writeText(text).then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), okMs || 1600);
      }).catch(() => {});
    }
    document.getElementById('btn-copy-code').addEventListener('click', function () { copyText(fenced, this); });
    document.getElementById('btn-copy-prompt').addEventListener('click', function () { copyText(fullPrompt, this, 2200); });

    /* Open in Renderer: #storyboard= deep link (TR compiles + opens the clip).
       Default path assumes TR is served from the same origin (vite serving
       design_concepts/); override with localStorage 'iitmTrUrl' when the
       site and the editor live on different hosts. */
    document.getElementById('btn-open-tr').addEventListener('click', () => {
      const sbEl = document.getElementById('storyboard-data');
      if (!sbEl) return;
      const b64 = btoa(unescape(encodeURIComponent(sbEl.textContent)))
        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      let trBase = '/studios/studio-pro-editor/docs/html-in-canvas/test-renderer.html';
      try { trBase = localStorage.getItem('iitmTrUrl') || trBase; } catch (e) {}
      window.open(trBase + '#storyboard=' + b64, '_blank');
      void base; /* available for origin-relative TR deployments */
    });

    window.__hicFenced = fenced;   /* debug/verification handle */
    window.__hicSeek = (ms) => { pause(); t = ms; drawAt(ms); };
  })();
</script>
