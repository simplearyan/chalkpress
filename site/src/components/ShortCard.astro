---
// One card on the shorts library shelf. Poster value/sub are editorial
// extras: storyboard.json may define a poster element we surface here.
interface Props {
  href: string;
  badge: string;
  title: string;
  sub: string;
  eyebrow: string;
  value: string;
  valueColor: string;
  duration?: string;
}
const { href, badge, title, sub, eyebrow, value, valueColor, duration } = Astro.props;
const secs = duration ? Math.round(Number(duration) / 1000) : null;
---
<a class="short-card" href={href}>
  <div class="short-thumb">
    <span class="badge">{badge}</span>
    {secs && <span class="duration">0:{String(secs).padStart(2, '0')}</span>}
    <div class="short-poster">
      <div class="p-eyebrow">{eyebrow}</div>
      <div class="p-value" style={`color:${valueColor}`}>{value}</div>
    </div>
    <div class="short-scrim">
      <div class="s-title">{title}</div>
      <div class="s-sub">{sub}</div>
    </div>
  </div>
  <div class="short-meta">
    <div class="m-topic">{badge}</div>
    <div class="m-cta">Solution + script + animation code →</div>
  </div>
</a>
