---
// Sticky top app bar (M3 "small top app bar"). Holds the back control, the
// page/series title, an optional segmented section switch (≥720px) and the
// theme button. The theme button keeps id="theme-toggle" — Base.astro wires it.
// The segmented tabs carry data-tab; BottomNav reuses the same contract, so the
// scroll-spy in Base.astro drives both without knowing which is on screen.
interface Props {
  title: string;
  /** Omit on top-level pages (the library) — no back affordance then. */
  back?: { href: string; label?: string };
  /** In-page sections, e.g. [{ id: 'solve', label: 'Work the problem' }]. */
  tabs?: { id: string; label: string }[];
}
const { title, back, tabs } = Astro.props;
const backLabel = back?.label ?? 'Library';
---
<header class="appbar">
  <div class="bar">
    <div class="bar-l">
      {back && (
        <a class="icon-btn back" href={back.href} aria-label={`Back to ${backLabel}`} title={backLabel}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
          <span class="back-lbl">{backLabel}</span>
        </a>
      )}
      <div class="title">{title}</div>
    </div>

    {tabs && tabs.length > 0 ? (
      <nav class="tabs" aria-label="Page sections">
        {tabs.map((t) => (
          <a class="tab" data-tab={t.id} href={`#part-${t.id}`}>{t.label}</a>
        ))}
      </nav>
    ) : (
      /* keeps the 1fr auto 1fr grid honest when there is nothing to switch */
      <span aria-hidden="true"></span>
    )}

    <div class="bar-r">
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM2 13h2v-2H2v2zm18 0h2v-2h-2v2zM11 2v2h2V2h-2zm0 18v2h2v-2h-2zM5.99 4.58 4.58 5.99l1.41 1.42 1.42-1.42-1.42-1.41zm12.02 12.02-1.41 1.41 1.41 1.42 1.42-1.42-1.42-1.41zm1.42-10.61-1.42-1.41-1.41 1.41 1.41 1.42 1.42-1.42zM7.4 18.01 5.99 16.6l-1.41 1.41 1.41 1.42 1.41-1.42z"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.3 3a9 9 0 1 0 8.7 11.6A7 7 0 0 1 12.3 3z"/></svg>
      </button>
    </div>
  </div>
</header>
